# ─── Required ────────────────────────────────────────────────────────────────
# Your Gemini API key. Used for the coding agent and sprite generation.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ─── Models ──────────────────────────────────────────────────────────────────
# Model used for new games. Switchable per game from the editor.
# Free-tier-capable models: gemini-3.8-flash, gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.8-flash

# Reasoning effort for supported Gemini models: minimal | low | medium | high
GEMINI_REASONING=medium

# Image model used by the generate_sprite tool.
# Image generation may require paid API access and returns a chroma-key background.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# ─── Context budget ──────────────────────────────────────────────────────────
# Estimated context tokens before older turns are folded into a summary.
COMPACT_AT=48000

# Recent turns always kept verbatim through a compaction.
KEEP_RECENT_TOKENS=14000

# Maximum tool calls the agent may make in a single turn.
MAX_AGENT_STEPS=48

# ─── Storage ─────────────────────────────────────────────────────────────────
# Where the SQLite database file is created.
DATA_DIR=./data

# ─── Optional ────────────────────────────────────────────────────────────────
# Path to Chrome or Chromium, used to screenshot running games for the `look`
# tool. Auto-detected on macOS and most Linux distros; set it if detection fails.
# CHROME_PATH=/usr/bin/google-chrome

# Extra hosts allowed to reach the dev server, e.g. to test from a phone.
# DEV_ORIGINS=192.168.1.20
